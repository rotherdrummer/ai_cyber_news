 "caveats": [
  {
   "title": "Configuration is half the score",
   "text": "Reasoning effort, tool access and agent scaffolds change results more than model choice does. A score without its configuration is not comparable."
  },
  {
   "title": "Lab model is not the shipped model",
   "text": "Cyber scores are usually measured on unrestricted internal builds. Products on sale are deliberately weaker, so lab figures overstate what a customer gets and understate what an attacker with open weights gets."
  },
  {
   "title": "Self-reported results",
   "text": "Results a developer reports about its own model are marked. They are not independently checked and may not match the benchmark owner's scoring."
  },
  {
   "title": "None of them measure your risk",
   "text": "No benchmark covers data residency, supply chain, model provenance or clinical safety in service. Benchmarks narrow a shortlist; they are not assurance."
  }
 ]
}